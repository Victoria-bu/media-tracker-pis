{
  "name": "media-tracker-pis",
  "version": "1.0.0",
  "description": "Personal Media Content Tracking IS — REST API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run && node scripts/write-test-log.js",
    "test:watch": "vitest",
    "test:stage1": "vitest run tests/integration/auth.test.ts tests/integration/users.test.ts tests/unit/services/authService.test.ts && node scripts/write-test-log.js stage1"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victoria-bu/media-tracker-pis.git"
  },
